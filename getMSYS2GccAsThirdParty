# Script
#     getMSYS2GccAsThirdParty
#
# Description
#     This script downloads and deploys a specific version of GCC and Binutils
#   from MSYS2, deploying it as a local third-party installation, not as part
#   of MSYS2 installation. This way it is possible to use an older version of
#   GCC, which was needed for building OpenFOAM 12 and dev in August 2024.
#
#   This is designed to be installed directly on Windows, so that it's ready
#   to be used after this script is finished.
#
#------------------------------------------------------------------------------

if ! isMinGW || ! onWin
then
  echo "Error: this script is meant to be used for MinGW compilers only and on Windows!"
  exit 1
fi


# get default GCC, mpfr, gmp and mpc versions
. $WM_PROJECT_DIR/etc/config.sh/functions
_foamSource $($WM_PROJECT_DIR/bin/foamEtcFile config.sh/compiler)

# run from third-party directory only
cd ${0%/*} || exit 1
wmakeCheckPwd "$WM_THIRD_PARTY_DIR" || {
    echo "Error: Current directory is not \$WM_THIRD_PARTY_DIR"
    echo "    The environment variables are inconsistent with the installation."
    echo "    Check the OpenFOAM entries in your dot-files and source them."
    exit 1
}
. etc/tools/ThirdPartyFunctions
. etc/tools/makeExtraThirdPartyFunctions


MSYS2_REPO="https://repo.msys2.org/mingw/mingw64/"
PACKAGE_PREFIX="mingw-w64-x86_64-"
PACKAGE_SUFFIX="-any.pkg.tar.zst"

# From makeGcc
installBASE=$WM_THIRD_PARTY_DIR/platforms/$WM_ARCH$WM_COMPILER_ARCH
GCC_ARCH_PATH=$installBASE/$gcc_version
GCC_VERSION=${gcc_version/gcc-/}

if [ ! -d "${GCC_ARCH_PATH}" ]
then
    mkdir -p "${GCC_ARCH_PATH}"
fi

if [ -z "$MSYS2_GCC_PATCH" -o -z "$MSYS2_BINUTILS_VERSION" ]
then
    echo "Error: \$MSYS2_GCC_PATCH and/or \$MSYS2_BINUTILS_VERSION not set, "
    echo "    therefore this is likely not properly configured."
    exit 1
fi

#end of initializations -------------------------------------------

function downloadFromMSYS2Repo()
{
    downloadFile ${PACKAGE_PREFIX}${1}${PACKAGE_SUFFIX} \
        ${MSYS2_REPO}${PACKAGE_PREFIX}${1}${PACKAGE_SUFFIX}
}


#script start ------------------------------------------------------

PACKAGES="binutils-$MSYS2_BINUTILS_VERSION"

for package in gcc gcc-libs gcc-fortran gcc-libgfortran
do
    PACKAGES="${PACKAGES} ${package}-${GCC_VERSION}-${MSYS2_GCC_PATCH}"
done

# Had to hard-code the package versions here
for package in \
    gmp-6.2.1-3 \
    mpfr-4.2.0.p4-1 \
    crt-git-10.0.0.r258.g530c58e17-2 \
    winpthreads-git-10.0.0.r258.g530c58e17-1 \
    libwinpthread-git-10.0.0.r258.g530c58e17-1 \
    windows-default-manifest-6.4-4
do
    PACKAGES="${PACKAGES} ${package}"
done

for package in ${PACKAGES}
do
    echo "Handling package '${package}'"
    downloadFromMSYS2Repo $package

    tar -xf download/${PACKAGE_PREFIX}${package}${PACKAGE_SUFFIX} \
        -C "${GCC_ARCH_PATH}" --transform="s/mingw64\///"
done

echo "Complete"
